{
  // UniMAP Resources Hub — Cloudflare Worker with static assets.
  // Secrets are NOT stored here. Set them with:
  //   npx wrangler secret put GAS_API_URL        (Apps Script API deployment /exec URL)
  //   npx wrangler secret put GAS_PROXY_SECRET   (same value as the PROXY_SHARED_SECRET script property)
  //   npx wrangler secret put IP_HASH_SECRET     (optional, any long random string)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unimap-resources-hub",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
